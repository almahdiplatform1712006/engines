{
  "name": "engines",
  "version": "0.0.0",
  "private": true,
  "description": "Engines: a teacher's own book in, questions and explanation out, filed under their syllabus tree.",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start:api": "node --env-file-if-exists=.env src/api/main.ts",
    "start:worker": "node --env-file-if-exists=.env src/worker/main.ts",
    "migrate": "node --env-file-if-exists=.env src/shared/db/migrate-cli.ts",
    "seed": "node --env-file-if-exists=.env src/accounts/seed-cli.ts",
    "credits": "node --env-file-if-exists=.env src/accounts/credits-cli.ts",
    "db:up": "docker compose up -d postgres",
    "golden:draft": "node --env-file-if-exists=.env src/golden/cli.ts draft",
    "golden:sheet": "node src/golden/cli.ts sheet",
    "golden:score": "node --env-file-if-exists=.env src/golden/cli.ts score",
    "typecheck": "tsc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test --test-global-setup=test/global-setup.ts \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.18",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "10.11.0",
    "fflate": "0.8.3",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "dependencies": {
    "@ai-sdk/google-vertex": "5.0.93",
    "@google-cloud/storage": "8.2.0",
    "@hono/node-server": "2.1.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.114",
    "docx": "9.7.2",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.11.1",
    "hono": "4.13.8",
    "katex": "0.18.7",
    "node-pg-migrate": "9.0.0",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "pg-boss": "12.33.3",
    "playwright-core": "1.63.0",
    "sharp": "0.35.4",
    "temml": "0.13.5",
    "zod": "4.6.5"
  },
  "allowScripts": {
    "@embedded-postgres/darwin-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/darwin-x64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-arm64@18.4.0-beta.17": true,
    "@embedded-postgres/linux-x64@18.4.0-beta.17": true,
    "@embedded-postgres/windows-x64@18.4.0-beta.17": true
  }
}
