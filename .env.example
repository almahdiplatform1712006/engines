# Copy to .env for local work. .env is git-ignored: never commit real values.
# In Cloud Run these come from Secret Manager.

# --- Service ---
PORT=8080

# --- Database ---
# Engines' own Postgres only. Locally: the docker compose database.
# Never Almahdi's database, and never Almahdi's production Cloud SQL server.
DATABASE_URL=postgres://engines:engines@localhost:5432/engines

# --- Storage ---
# local: files under STORAGE_DIR, served by the API under /local-storage (development).
# gcs: Engines' own buckets (never Almahdi's). Cloud Run's service account signs URLs.
STORAGE=local
STORAGE_DIR=.data/storage
# Where the API is reachable; upload and image URLs start with it.
PUBLIC_URL=http://localhost:8080
# Signs local upload and image URLs. Any random string of 16+ characters.
LOCAL_STORAGE_SECRET=
GCS_BUCKET_UPLOADS=
GCS_BUCKET_PAGES=
GCS_BUCKET_RESULTS=

# --- Worker ---
# Page tasks one worker reads at once.
PAGE_CONCURRENCY=4

# --- Model access ---
# The provider is a setting on each API key (openrouter | vertex); these configure both.
# The model name is config, never hard-coded at a call site.
AI_MODEL=
# The cheap model for the quick pass that reads printed page numbers. Defaults to AI_MODEL.
AI_MODEL_CHEAP=
# OpenRouter (zero data retention, provider.require_parameters: true)
OPENROUTER_API_KEY=
# Vertex AI
VERTEX_PROJECT=
VERTEX_LOCATION=

# --- Golden set (npm run golden:draft / golden:score) ---
# Which page reader to run: `stub` (no model, empty drafts) or `model` (AI_MODEL on OpenRouter).
GOLDEN_READER=stub
