# Copy to .env for local work. .env is git-ignored: never commit real values.
# In Cloud Run these come from Secret Manager.

# --- Service ---
PORT=8080

# --- Database ---
# Engines' own Postgres only. Locally: the docker compose database.
# Never Almahdi's database, and never Almahdi's production Cloud SQL server.
DATABASE_URL=postgres://engines:engines@localhost:5432/engines

# --- Model access (read from the reading tickets on; one setting per API key later) ---
# openrouter | vertex
AI_PROVIDER=openrouter
# The model name is config, never hard-coded at a call site.
AI_MODEL=
# OpenRouter (zero data retention, provider.require_parameters: true)
OPENROUTER_API_KEY=
# Vertex AI
VERTEX_PROJECT=
VERTEX_LOCATION=

# --- Golden set (npm run golden:draft / golden:score) ---
# Which page reader to run. Only `stub` exists until the reading tickets add the model reader.
GOLDEN_READER=stub
